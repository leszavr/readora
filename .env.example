# Окружение приложения
NODE_ENV=development

# Сервер API
PORT=8080
APP_ORIGIN=http://localhost:3000
# Публичный URL для canonical, Open Graph, robots.txt и sitemap.xml.
# В production должен соответствовать домену приложения.
PUBLIC_BASE_URL=http://localhost:3000

# База данных PostgreSQL
# Локально проще всего: docker compose up -d postgres
DATABASE_URL=postgresql://readora:readora@localhost:5432/readora

# Сессии (express-session, cookie-based)
# Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# Каталог для загружаемых книг (относительно корня репо или абсолютный путь)
UPLOADS_DIR=./uploads

# Логирование (pino): trace | debug | info | warn | error
LOG_LEVEL=info

# Встроенный планировщик агрегирования аналитики в PostgreSQL. По умолчанию включён;
# установите false только если его запускает отдельный процесс приложения.
ANALYTICS_ROLLUP_ENABLED=true

# Базовый путь фронтенда (для деплоя за reverse proxy в подпапке)
BASE_PATH=/

# SMTP-настройки (email-верификация, сброс пароля) задаются через админ-панель,
# а не через переменные окружения.

# Яндекс ID OAuth (вход через Яндекс)
# Значения берутся из https://oauth.yandex.ru/ → ваше приложение
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID OAuth (вход через VK ID)
VK_CLIENT_ID=
VK_SERVICE_TOKEN=
